<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Entries | Open House Feedback</title>
  <%- include('partials-head') %>
</head>
<body>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/">&larr; All agents</a>
      <h1>All Open House Feedback</h1>
      <p class="subtitle"><%= entries.length %> total entries across all agents.</p>
      <a class="btn-secondary" href="/admin/export.csv">Export CSV</a>
    </header>

    <section class="card">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Address</th>
              <th>Buyer</th>
              <th>Agent</th>
              <th>Has Agent</th>
              <th>Interested</th>
              <th>Feedback/Notes</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(e) { %>
              <tr>
                <td><%= new Date(e.date).toLocaleDateString() %></td>
                <td><%= e.address %></td>
                <td><%= e.buyerName %></td>
                <td><%= e.agentName %></td>
                <td><%= e.hasAgent ? 'Yes' : 'No' %></td>
                <td><span class="badge badge-<%= e.interested.toLowerCase() %>"><%= e.interested %></span></td>
                <td class="feedback-cell"><%= e.feedback || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</body>
</html>
