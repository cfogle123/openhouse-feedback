<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Availability | Open House Feedback</title>
  <%- include('partials-head') %>
  <style>
    /* Widen this page only so the availability grid has room to lay out
       every agent column at full width instead of being squeezed into the
       site's normal 1000px content column. */
    .wrap { max-width: 1600px; }
    /* Let the table size itself to its natural (content-driven) width
       instead of being forced to exactly fill the container. Combined with
       .table-scroll's overflow-x: auto, this means: on a wide enough
       screen everything just fits; on a narrower screen/window the table
       scrolls sideways instead of squishing every column unreadably. */
    table { width: auto; min-width: 100%; }
    th, td { padding: 8px 6px; }
    .avail-cell { white-space: nowrap; }
    .avail-cell .badge { padding: 2px 8px; font-size: 11px; }
    .avail-comment { display: block; font-size: 11px; color: var(--muted); white-space: normal; max-width: 140px; margin-top: 2px; }
    .assignment-input { width: 150px; }
  </style>
</head>
<body>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/admin/feedback">&larr; Open House Feedback</a>
      <h1>Open House Availability</h1>
      <p class="subtitle">Everyone's availability for the remaining weekends this year. Fill in "Assignment" to note who's covering each date.</p>
    </header>

    <% if (saved) { %>
      <div class="card" style="border-color: var(--yes); background: #f0f8f1;">
        <strong style="color: var(--yes);">Saved.</strong> Assignments updated.
      </div>
    <% } %>

    <section class="card">
      <form method="POST" action="/admin/availability">
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <% agents.forEach(function(a) { %><th><%= a.name %></th><% }); %>
                <th>Assignment / Notes</th>
              </tr>
            </thead>
            <tbody>
              <% days.forEach(function(day) { %>
                <tr>
                  <td><%= day.label %></td>
                  <% day.cells.forEach(function(cell) { %>
                    <td class="avail-cell">
                      <% if (cell.status === 'Available') { %>
                        <span class="badge badge-yes">Available</span>
                      <% } else if (cell.status === 'Unavailable') { %>
                        <span class="badge badge-no">Unavailable</span>
                      <% } else { %>
                        <span class="muted">&mdash;</span>
                      <% } %>
                      <% if (cell.comment) { %><span class="avail-comment"><%= cell.comment %></span><% } %>
                    </td>
                  <% }); %>
                  <td>
                    <input type="text" class="assignment-input" name="assignment_<%= day.key %>" value="<%= day.assignment %>" placeholder="e.g. Meredith">
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Save Assignments</button>
        </div>
      </form>
    </section>
  </div>
</body>
</html>
