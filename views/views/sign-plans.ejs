<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Plans | Open House Feedback</title>
  <%- include('partials-head') %>
</head>
<body>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/">&larr; Open House</a>
      <h1>Sign Plans</h1>
      <p class="subtitle">A shared library of open house sign placement documents. Any agent can upload or download.</p>
    </header>

    <section class="card form-card">
      <h2>Upload a Sign Plan</h2>
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="form-error"><%= error %></p>
      <% } %>
      <form method="POST" action="/sign-plans" enctype="multipart/form-data">
        <div class="form-row">
          <label class="full-width">
            Document (PDF or Word)
            <input type="file" name="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required>
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">
            Your name (optional)
            <input type="text" name="uploaded_by" placeholder="e.g. Sandy">
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Upload</button>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>Uploaded Documents (<%= plans.length %>)</h2>
      <% if (plans.length === 0) { %>
        <p class="empty-state">No sign plans uploaded yet.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>File</th><th>Uploaded by</th><th>Date</th><th></th></tr>
            </thead>
            <tbody>
              <% plans.forEach(function(p) { %>
                <tr>
                  <td><a href="/sign-plans/<%= p.id %>/download" target="_blank" rel="noopener"><%= p.filename %></a></td>
                  <td><%= p.uploaded_by || '—' %></td>
                  <td><%= new Date(p.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                  <td class="row-actions">
                    <form method="POST" action="/sign-plans/<%= p.id %>/delete" onsubmit="return confirm('Remove this document?');">
                      <button type="submit" class="link-btn">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </div>
</body>
</html>
