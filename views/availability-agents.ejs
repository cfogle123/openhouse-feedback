<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Open House Availability | The List Realty</title>
  <%- include('partials-head') %>
</head>
<body>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/">&larr; Home</a>
      <h1>Open House Availability</h1>
      <p class="subtitle">Select your name to check off the days you can work an open house through the end of the year.</p>
    </header>

    <div class="agent-grid">
      <% agents.forEach(function(agent) { %>
        <a class="agent-card" href="/agent/<%= agent.slug %>/availability">
          <div class="agent-initial"><%= agent.name.charAt(0) %></div>
          <div class="agent-name"><%= agent.name %></div>
        </a>
      <% }); %>
    </div>

    <footer class="footer">
      <a href="/admin/availability">View everyone's availability (admin)</a>
    </footer>
  </div>
</body>
</html>
