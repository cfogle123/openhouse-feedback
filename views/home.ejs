<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Open House Feedback | The List Realty</title>
  <%- include('partials-head') %>
</head>
<body>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <h1>Open House Feedback</h1>
      <p class="subtitle">Select your name below to log a new open house, review past entries, or set your availability.</p>
    </header>

    <h2 class="section-heading">Log Feedback</h2>
    <div class="agent-grid">
      <% agents.forEach(function(agent) { %>
        <a class="agent-card" href="/agent/<%= agent.slug %>">
          <div class="agent-initial"><%= agent.name.charAt(0) %></div>
          <div class="agent-name"><%= agent.name %></div>
        </a>
      <% }); %>
    </div>

    <h2 class="section-heading">Set Availability</h2>
    <div class="agent-grid">
      <% agents.forEach(function(agent) { %>
        <a class="agent-card agent-card-alt" href="/agent/<%= agent.slug %>/availability">
          <div class="agent-initial agent-initial-alt"><%= agent.name.charAt(0) %></div>
          <div class="agent-name"><%= agent.name %></div>
        </a>
      <% }); %>
    </div>

    <footer class="footer">
      <a href="/admin">View all entries (admin)</a>
      &nbsp;&middot;&nbsp;
      <a href="/houses">Browse by house</a>
    </footer>
  </div>
</body>
</html>
