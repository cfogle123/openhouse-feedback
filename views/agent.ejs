<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= agent.name %> | Open House Feedback</title>
  <%- include('partials-head') %>
</head>
<body>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/">&larr; All agents</a>
      <h1><%= agent.name %>'s Open Houses</h1>
      <p class="subtitle">Enter details within 1 hour of the open house ending. Keep more detailed notes in Follow Up Boss.</p>
      <a class="btn-secondary" href="/agent/<%= agent.slug %>/availability">Set My Availability</a>
    </header>

    <section class="card form-card">
      <h2><%= editEntry ? 'Edit Entry' : 'Log New Entry' %></h2>
      <form method="POST" action="<%= editEntry ? ('/agent/' + agent.slug + '/entries/' + editEntry.id) : ('/agent/' + agent.slug + '/entries') %>">
        <div class="form-row">
          <label>
            Date
            <input type="date" name="date" value="<%= editEntry ? editEntry.dateInput : today %>" required>
          </label>
          <label class="autocomplete-wrap">
            Address
            <input type="text" name="address" id="addressInput" placeholder="123 Main St" value="<%= editEntry ? editEntry.address : '' %>" autocomplete="off" required>
            <ul id="addressSuggestions" class="suggestion-list" hidden></ul>
          </label>
        </div>
        <div class="form-row">
          <label>
            Buyer Name
            <input type="text" name="buyerName" placeholder="Jane Doe" value="<%= editEntry ? editEntry.buyerName : '' %>" required>
          </label>
          <label>
            Buyer Phone
            <input type="tel" name="buyerPhone" placeholder="(555) 555-5555" value="<%= editEntry ? (editEntry.buyerPhone || '') : '' %>">
          </label>
        </div>
        <div class="form-row">
          <label>
            Buyer Email
            <input type="email" name="buyerEmail" placeholder="jane@email.com" value="<%= editEntry ? (editEntry.buyerEmail || '') : '' %>">
          </label>
          <label>
            Interested?
            <select name="interested">
              <% interestOptions.forEach(function(opt) { %>
                <option value="<%= opt %>" <%= editEntry && editEntry.interested === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
          </label>
        </div>
        <div class="form-row">
          <label class="checkbox-label">
            <input type="checkbox" name="hasAgent" id="hasAgent" <%= editEntry && editEntry.hasAgent ? 'checked' : '' %>>
            Buyer already has an agent
          </label>
        </div>
        <div class="form-row" id="agentNameRow" style="<%= (editEntry && editEntry.hasAgent) ? '' : 'display:none;' %>">
          <label class="full-width">
            Buyer's Agent Name
            <input type="text" name="buyerAgentName" id="buyerAgentName" placeholder="Agent's name" value="<%= editEntry ? (editEntry.buyerAgentName || '') : '' %>">
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">
            Feedback / Notes
            <textarea name="feedback" rows="3" placeholder="Brief description of feedback received"><%= editEntry ? (editEntry.feedback || '') : '' %></textarea>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary"><%= editEntry ? 'Save Changes' : 'Add Entry' %></button>
          <% if (editEntry) { %>
            <a class="btn-secondary" href="/agent/<%= agent.slug %>">Cancel</a>
          <% } %>
        </div>
      </form>
    </section>

    <section class="card">
      <h2>Your Entries (<%= totalCount %>)</h2>
      <% if (totalCount === 0) { %>
        <p class="empty-state">No entries yet. Add your first one above.</p>
      <% } else { %>
        <% groups.forEach(function(group) { %>
          <div class="house-group">
            <h3 class="house-heading"><%= group.address %> <span class="house-count">(<%= group.entries.length %>)</span></h3>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Buyer</th>
                    <th>Contact</th>
                    <th>Buyer's Agent</th>
                    <th>Interested</th>
                    <th>Feedback/Notes</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% group.entries.forEach(function(e) { %>
                    <tr>
                      <td><%= new Date(e.date).toLocaleDateString() %></td>
                      <td><%= e.buyerName %></td>
                      <td class="muted"><%= e.buyerPhone || '' %><% if (e.buyerPhone && e.buyerEmail) { %><br><% } %><%= e.buyerEmail || '' %></td>
                      <td><%= e.hasAgent ? (e.buyerAgentName || 'Yes') : 'No' %></td>
                      <td><span class="badge badge-<%= e.interested.toLowerCase() %>"><%= e.interested %></span></td>
                      <td class="feedback-cell"><%= e.feedback || '' %></td>
                      <td class="row-actions">
                        <a href="/agent/<%= agent.slug %>/entries/<%= e.id %>/edit">Edit</a>
                        <form method="POST" action="/agent/<%= agent.slug %>/entries/<%= e.id %>/delete" onsubmit="return confirm('Delete this entry?');">
                          <button type="submit" class="link-btn">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% }); %>
      <% } %>
    </section>
  </div>

  <script>
    (function () {
      var cb = document.getElementById('hasAgent');
      var row = document.getElementById('agentNameRow');
      var nameInput = document.getElementById('buyerAgentName');
      if (!cb || !row) return;
      cb.addEventListener('change', function () {
        row.style.display = cb.checked ? '' : 'none';
        if (!cb.checked && nameInput) nameInput.value = '';
      });
    })();

    // House address autocomplete. Replaces the native <input list> /
    // <datalist> combo, which iOS Safari does not reliably show a dropdown
    // for on phones (a long-standing WebKit limitation) even though it works
    // fine on desktop browsers. This is a small custom suggestion list built
    // with plain JS so it behaves the same on phone and computer.
    (function () {
      var HOUSE_OPTIONS = <%- JSON.stringify(houses.map(function (h) { return h.address; })) %>;
      var input = document.getElementById('addressInput');
      var list = document.getElementById('addressSuggestions');
      if (!input || !list) return;

      var activeIndex = -1;

      function render(matches) {
        list.innerHTML = '';
        activeIndex = -1;
        if (matches.length === 0) {
          list.hidden = true;
          return;
        }
        matches.forEach(function (address) {
          var li = document.createElement('li');
          li.className = 'suggestion-item';
          li.textContent = address;
          li.setAttribute('role', 'option');
          li.addEventListener('mousedown', function (e) {
            // mousedown (not click) fires before the input's blur event, so
            // the selection registers even though the list is about to hide.
            e.preventDefault();
            input.value = address;
            list.hidden = true;
          });
          list.appendChild(li);
        });
        list.hidden = false;
      }

      function matchesFor(query) {
        var q = query.trim().toLowerCase();
        var pool = HOUSE_OPTIONS;
        if (q) pool = pool.filter(function (a) { return a.toLowerCase().indexOf(q) !== -1; });
        return pool.slice(0, 8);
      }

      input.addEventListener('focus', function () {
        render(matchesFor(input.value));
      });
      input.addEventListener('input', function () {
        render(matchesFor(input.value));
      });
      input.addEventListener('blur', function () {
        // Slight delay so a tap on a suggestion (mousedown) still lands
        // before the list disappears.
        setTimeout(function () { list.hidden = true; }, 100);
      });
      input.addEventListener('keydown', function (e) {
        var items = list.querySelectorAll('.suggestion-item');
        if (list.hidden || items.length === 0) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
        } else if (e.key === 'Enter' && activeIndex >= 0) {
          e.preventDefault();
          input.value = items[activeIndex].textContent;
          list.hidden = true;
          return;
        } else if (e.key === 'Escape') {
          list.hidden = true;
          return;
        } else {
          return;
        }
        items.forEach(function (el, i) { el.classList.toggle('active', i === activeIndex); });
      });
    })();
  </script>
</body>
</html>
