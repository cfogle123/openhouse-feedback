<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= agent.name %> | Open House Feedback</title>
  <%- include('partials-head') %>
</head>
<body>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/">&larr; All agents</a>
      <h1><%= agent.name %>'s Open Houses</h1>
      <p class="subtitle">Enter details within 1 hour of the open house ending. Keep more detailed notes in Follow Up Boss.</p>
      <a class="btn-secondary" href="/agent/<%= agent.slug %>/availability">Set My Availability</a>
    </header>

    <section class="card form-card">
      <h2><%= editEntry ? 'Edit Entry' : 'Log New Entry' %></h2>
      <form method="POST" action="<%= editEntry ? ('/agent/' + agent.slug + '/entries/' + editEntry.id) : ('/agent/' + agent.slug + '/entries') %>">
        <div class="form-row">
          <label>
            Date
            <input type="date" name="date" value="<%= editEntry ? editEntry.dateInput : today %>" required>
          </label>
          <label class="autocomplete-wrap">
            Open House Address
            <input type="text" name="address" id="addressInput" placeholder="123 Main St" value="<%= editEntry ? editEntry.address : '' %>" autocomplete="off" required>
            <ul id="addressSuggestions" class="suggestion-list" hidden></ul>
          </label>
        </div>
        <div class="form-row">
          <label>
            Buyer Name
            <input type="text" name="buyerName" placeholder="Jane Doe" value="<%= editEntry ? editEntry.buyerName : '' %>" required>
          </label>
          <label>
            Buyer Phone
            <input type="tel" name="buyerPhone" placeholder="(555) 555-5555" value="<%= editEntry ? (editEntry.buyerPhone || '') : '' %>">
          </label>
        </div>
        <div class="form-row">
          <label>
            Buyer Email
            <input type="email" name="buyerEmail" placeholder="jane@email.com" value="<%= editEntry ? (editEntry.buyerEmail || '') : '' %>">
          </label>
          <label>
            Interested?
            <select name="interested">
              <% interestOptions.forEach(function(opt) { %>
                <option value="<%= opt %>" <%= editEntry && editEntry.interested === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
          </label>
        </div>
        <div class="form-row">
          <label class="checkbox-label">
            <input type="checkbox" name="hasAgent" id="hasAgent" <%= editEntry && editEntry.hasAgent ? 'checked' : '' %>>
            Buyer already has an agent
          </label>
        </div>
        <div class="form-row" id="agentNameRow" style="<%= (editEntry && editEntry.hasAgent) ? '' : 'display:none;' %>">
          <label class="full-width">
            Buyer's Agent Name
            <input type="text" name="buyerAgentName" id="buyerAgentName" placeholder="Agent's name" value="<%= editEntry ? (editEntry.buyerAgentName || '') : '' %>">
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">
            Feedback / Notes
            <textarea name="feedback" rows="3" placeholder="Brief description of feedback received"><%= editEntry ? (editEntry.feedback || '') : '' %></textarea>
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary"><%= editEntry ? 'Save Changes' : 'Add Entry' %></button>
          <% if (editEntry) { %>
            <a class="btn-secondary" href="/agent/<%= agent.slug %>">Cancel</a>
          <% } else { %>
            <button type="button" class="btn-secondary" id="scanFormBtn">Scan Feedback Form</button>
            <input type="file" id="scanFormInput" accept="image/*" capture="environment" style="display:none;">
          <% } %>
        </div>
        <p id="scanStatus" class="scan-status" style="display:none;"></p>
      </form>
    </section>

    <section class="card">
      <h2>Your Entries (<%= totalCount %>)</h2>
      <% if (totalCount === 0) { %>
        <p class="empty-state">No entries yet. Add your first one above.</p>
      <% } else { %>
        <% groups.forEach(function(group) { %>
          <div class="house-group">
            <h3 class="house-heading"><%= group.address %> <span class="house-count">(<%= group.entries.length %>)</span></h3>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Buyer</th>
                    <th>Contact</th>
                    <th>Buyer's Agent</th>
                    <th>Interested</th>
                    <th>Feedback/Notes</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% group.entries.forEach(function(e) { %>
                    <tr>
                      <td><%= new Date(e.date).toLocaleDateString() %></td>
                      <td><%= e.buyerName %></td>
                      <td class="muted"><%= e.buyerPhone || '' %><% if (e.buyerPhone && e.buyerEmail) { %><br><% } %><%= e.buyerEmail || '' %></td>
                      <td><%= e.hasAgent ? (e.buyerAgentName || 'Yes') : 'No' %></td>
                      <td><% if (e.interested) { %><span class="badge badge-<%= e.interested.toLowerCase() %>"><%= e.interested %></span><% } else { %><span class="badge badge-unset">Not set</span><% } %></td>
                      <td class="feedback-cell"><%= e.feedback || '' %></td>
                      <td class="row-actions">
                        <a href="/agent/<%= agent.slug %>/entries/<%= e.id %>/edit">Edit</a>
                        <form method="POST" action="/agent/<%= agent.slug %>/entries/<%= e.id %>/delete" onsubmit="return confirm('Delete this entry?');">
                          <button type="submit" class="link-btn">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        <% }); %>
      <% } %>
    </section>
  </div>

  <script src="/js/address-autocomplete.js"></script>
  <script>
    (function () {
      var cb = document.getElementById('hasAgent');
      var row = document.getElementById('agentNameRow');
      var nameInput = document.getElementById('buyerAgentName');
      if (!cb || !row) return;
      cb.addEventListener('change', function () {
        row.style.display = cb.checked ? '' : 'none';
        if (!cb.checked && nameInput) nameInput.value = '';
      });
    })();

    // House address autocomplete. See public/js/address-autocomplete.js for
    // why this is a custom widget instead of native <input list>/<datalist>.
    initAddressAutocomplete(
      document.getElementById('addressInput'),
      document.getElementById('addressSuggestions'),
      { addresses: <%- JSON.stringify(houses.map(function (h) { return h.address; })) %> }
    );

    // Scan Feedback Form: lets an agent snap a photo of a paper form
    // instead of retyping it. The photo is sent to the server, which reads
    // it via Claude's vision API and returns extracted fields -- those just
    // pre-fill this same form so the agent still reviews everything before
    // hitting Add Entry, nothing is saved automatically from the photo.
    (function () {
      var btn = document.getElementById('scanFormBtn');
      var input = document.getElementById('scanFormInput');
      var status = document.getElementById('scanStatus');
      if (!btn || !input || !status) return;

      btn.addEventListener('click', function () { input.click(); });

      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        if (!file) return;

        status.style.display = '';
        status.className = 'scan-status';
        status.textContent = 'Reading photo\u2026 this can take a few seconds.';
        btn.disabled = true;

        var formData = new FormData();
        formData.append('photo', file);

        fetch('/agent/<%= agent.slug %>/entries/scan', { method: 'POST', body: formData })
          .then(function (res) {
            return res.json().then(function (data) { return { ok: res.ok, data: data }; });
          })
          .then(function (result) {
            btn.disabled = false;
            if (!result.ok) {
              status.className = 'scan-status scan-error';
              status.textContent = result.data && result.data.error ? result.data.error : 'Could not read that photo.';
              return;
            }
            var f = result.data.fields;
            if (f.address) document.getElementById('addressInput').value = f.address;
            document.querySelector('input[name="buyerName"]').value = f.buyerName || '';
            document.querySelector('input[name="buyerPhone"]').value = f.buyerPhone || '';
            document.querySelector('input[name="buyerEmail"]').value = f.buyerEmail || '';
            if (f.interested) document.querySelector('select[name="interested"]').value = f.interested;
            var hasAgentCb = document.getElementById('hasAgent');
            if (hasAgentCb) {
              hasAgentCb.checked = Boolean(f.hasAgent);
              hasAgentCb.dispatchEvent(new Event('change'));
            }
            if (f.hasAgent && f.buyerAgentName) document.getElementById('buyerAgentName').value = f.buyerAgentName;
            document.querySelector('textarea[name="feedback"]').value = f.feedback || '';

            status.className = 'scan-status scan-success';
            status.textContent = 'Filled in from the photo \u2014 please review before saving.';
          })
          .catch(function () {
            btn.disabled = false;
            status.className = 'scan-status scan-error';
            status.textContent = 'Something went wrong reading that photo. Please try again.';
          });

        // Allow re-selecting the same file again later (change event won't
        // fire a second time otherwise if the exact same file is chosen).
        input.value = '';
      });
    })();
  </script>

</body>
</html>
