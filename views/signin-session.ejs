<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome | The List Realty Open House</title>
  <%- include('partials-head') %>
</head>
<body>
<% if (housePhotoUrl) { %>
  <div class="kiosk-split">
    <div class="kiosk-photo-panel" style="background-image: url('<%= housePhotoUrl %>');">
      <div class="kiosk-photo-overlay">
        <div class="kiosk-address"><%= house %></div>
        <div class="kiosk-host">
          <%- include('partials-agent-avatar', { agent: agent }) %>
          <span>Hosted by <%= agent.name %> of The List Realty</span>
        </div>
      </div>
    </div>
    <div class="kiosk-form-panel">
      <a class="back-link" href="/signin/house/<%= agent.slug %>">&larr; Wrong house? Start over</a>
      <h1>Welcome!</h1>
      <p class="subtitle">Please fill out your info below.</p>

      <% if (submitted) { %>
        <div class="card" style="border-color: var(--yes); background: #f0f8f1; margin-bottom: 20px;">
          <strong style="color: var(--yes);">Thanks!</strong> You're signed in. Enjoy the open house.
        </div>
      <% } %>

      <form method="POST" action="/signin/session" id="visitorForm">
        <input type="hidden" name="agentSlug" value="<%= agent.slug %>">
        <input type="hidden" name="house" value="<%= house %>">

        <div class="form-row">
          <label>
            First Name
            <input type="text" name="visitorFirstName" id="visitorFirstName" placeholder="Jane" required>
          </label>
          <label>
            Last Name
            <input type="text" name="visitorLastName" placeholder="Doe" required>
          </label>
        </div>
        <div class="form-row">
          <label>
            Email Address
            <input type="email" name="visitorEmail" placeholder="jane@email.com">
          </label>
          <label>
            Phone Number
            <input type="tel" name="visitorPhone" placeholder="(555) 555-5555">
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">
            Home Address
            <input type="text" name="visitorHomeAddress" placeholder="123 Current St, City, State">
          </label>
        </div>
        <div class="form-row">
          <label>
            Do you own or rent your current home?
            <select name="visitorOwnRent">
              <option value="">&mdash; Select &mdash;</option>
              <option value="Own">Own</option>
              <option value="Rent">Rent</option>
            </select>
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">Do you have a signed agreement with a buyer's agent?</label>
        </div>
        <div class="form-row radio-group">
          <label><input type="radio" name="hasAgent" value="yes" required> Yes</label>
          <label><input type="radio" name="hasAgent" value="no" required> No</label>
        </div>
        <div class="form-row" id="agentNameRow" style="display:none;">
          <label class="full-width">
            Your Agent's Name
            <input type="text" name="visitorAgentName" id="visitorAgentName" placeholder="Agent's name">
          </label>
        </div>
        <div class="form-row" id="offMarketRow" style="display:none;">
          <label class="full-width">Are you interested in knowing about our off-market listings?</label>
        </div>
        <div class="form-row radio-group" id="offMarketRadios" style="display:none;">
          <label><input type="radio" name="wantsOffMarket" value="yes"> Yes</label>
          <label><input type="radio" name="wantsOffMarket" value="no"> No</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Sign In</button>
        </div>
      </form>
    </div>
  </div>
<% } else { %>
  <%- include('partials-topbar') %>
  <div class="wrap">
    <header class="page-header">
      <a class="back-link" href="/signin/house/<%= agent.slug %>">&larr; Wrong house? Start over</a>
      <h1>Welcome!</h1>
      <p class="subtitle">You're signing in at <strong><%= house %></strong>, hosted by <%= agent.name %>. Please fill out your info below.</p>
    </header>

    <% if (submitted) { %>
      <div class="card" style="border-color: var(--yes); background: #f0f8f1; margin-bottom: 20px;">
        <strong style="color: var(--yes);">Thanks!</strong> You're signed in. Enjoy the open house.
      </div>
    <% } %>

    <section class="card form-card">
      <form method="POST" action="/signin/session" id="visitorFormFallback">
        <input type="hidden" name="agentSlug" value="<%= agent.slug %>">
        <input type="hidden" name="house" value="<%= house %>">

        <div class="form-row">
          <label>
            First Name
            <input type="text" name="visitorFirstName" id="visitorFirstNameFallback" placeholder="Jane" required>
          </label>
          <label>
            Last Name
            <input type="text" name="visitorLastName" placeholder="Doe" required>
          </label>
        </div>
        <div class="form-row">
          <label>
            Email Address
            <input type="email" name="visitorEmail" placeholder="jane@email.com">
          </label>
          <label>
            Phone Number
            <input type="tel" name="visitorPhone" placeholder="(555) 555-5555">
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">
            Home Address
            <input type="text" name="visitorHomeAddress" placeholder="123 Current St, City, State">
          </label>
        </div>
        <div class="form-row">
          <label>
            Do you own or rent your current home?
            <select name="visitorOwnRent">
              <option value="">&mdash; Select &mdash;</option>
              <option value="Own">Own</option>
              <option value="Rent">Rent</option>
            </select>
          </label>
        </div>
        <div class="form-row">
          <label class="full-width">Do you have a signed agreement with a buyer's agent?</label>
        </div>
        <div class="form-row radio-group">
          <label><input type="radio" name="hasAgent" value="yes" required> Yes</label>
          <label><input type="radio" name="hasAgent" value="no" required> No</label>
        </div>
        <div class="form-row" id="agentNameRowFallback" style="display:none;">
          <label class="full-width">
            Your Agent's Name
            <input type="text" name="visitorAgentName" placeholder="Agent's name">
          </label>
        </div>
        <div class="form-row" id="offMarketRowFallback" style="display:none;">
          <label class="full-width">Are you interested in knowing about our off-market listings?</label>
        </div>
        <div class="form-row radio-group" id="offMarketRadiosFallback" style="display:none;">
          <label><input type="radio" name="wantsOffMarket" value="yes"> Yes</label>
          <label><input type="radio" name="wantsOffMarket" value="no"> No</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-primary">Sign In</button>
        </div>
      </form>
    </section>
  </div>
<% } %>

  <script>
    (function () {
      // Only one of the two layouts above is ever rendered at once, so a
      // radio group named "hasAgent" (or "wantsOffMarket") never collides
      // with itself -- the split/fallback distinction only matters for the
      // row containers, which do have separate ids per layout.
      function agentNameRow() { return document.getElementById('agentNameRow') || document.getElementById('agentNameRowFallback'); }
      function offMarketRow() { return document.getElementById('offMarketRow') || document.getElementById('offMarketRowFallback'); }
      function offMarketRadiosRow() { return document.getElementById('offMarketRadios') || document.getElementById('offMarketRadiosFallback'); }
      function agentNameInput() { return document.getElementById('visitorAgentName') || document.querySelector('input[name="visitorAgentName"]'); }

      function toggle() {
        var selected = document.querySelector('input[name="hasAgent"]:checked');
        var value = selected ? selected.value : '';

        var nameRow = agentNameRow();
        if (nameRow) nameRow.style.display = value === 'yes' ? '' : 'none';
        if (value !== 'yes') {
          var nameInput = agentNameInput();
          if (nameInput) nameInput.value = '';
        }

        var omRow = offMarketRow();
        var omRadios = offMarketRadiosRow();
        var showOffMarket = value === 'no';
        if (omRow) omRow.style.display = showOffMarket ? '' : 'none';
        if (omRadios) omRadios.style.display = showOffMarket ? '' : 'none';
        if (!showOffMarket) {
          document.querySelectorAll('input[name="wantsOffMarket"]').forEach(function (r) { r.checked = false; });
        }
      }

      document.querySelectorAll('input[name="hasAgent"]').forEach(function (r) {
        r.addEventListener('change', toggle);
      });
      toggle();
    })();

    // Keep the device ready for the next visitor: focus the first name
    // field on load so whoever's handed the tablet next can just start typing.
    (function () {
      var nameField = document.getElementById('visitorFirstName') || document.getElementById('visitorFirstNameFallback');
      if (nameField) nameField.focus();
    })();
  </script>
</body>
</html>
